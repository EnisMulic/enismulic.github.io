---
import type { CollectionItem } from '../../../data/collection';

interface Props {
  item: CollectionItem;
  shape?: 'portrait' | 'square';
}

const { item, shape = 'portrait' } = Astro.props;
const { crop } = item;
// Scales and shifts the image so only the crop region fills the cover box.
const cropStyle = crop
  ? `position: absolute; width: ${(100 / crop.w) * 100}%; height: ${(100 / crop.h) * 100}%; left: ${(-crop.x / crop.w) * 100}%; top: ${(-crop.y / crop.h) * 100}%;`
  : undefined;
---

<li class:list={['item', { wishlist: item.wishlist }]}>
  <span class:list={['cover', shape]} aria-hidden="true">
    {item.cover && <img src={item.cover} alt="" loading="lazy" decoding="async" style={cropStyle} />}
  </span>
  <span class="title">
    {item.title}
    {item.wishlist && <span class="sr-only"> (on the wishlist)</span>}
  </span>
  <span class="by">{item.by}</span>
  {item.note && <span class="note">{item.note}</span>}
</li>

<style>
  .item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .wishlist {
    opacity: 0.4;
    transition: opacity 0.15s;
  }

  .wishlist:hover { opacity: 0.8; }

  .cover {
    position: relative;
    display: block;
    aspect-ratio: 2 / 3;
    margin-bottom: 0.65rem;
    background: var(--bg);
    border: 1px solid var(--subtle);
    border-radius: 4px;
    overflow: hidden;
  }

  .square {
    aspect-ratio: 1;
    border-radius: 2px;
  }

  .cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .title {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    line-height: 1.3;
  }

  .by,
  .note {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .note { font-style: italic; }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
