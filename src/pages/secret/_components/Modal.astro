---
interface Props {
  // Used as the dialog's id; a StatCard with the same `opens` value opens it
  id: string;
  label: string;
  title: string;
  summary?: string;
}

const { id, label, title, summary } = Astro.props;
---

<dialog class="modal" id={id} aria-labelledby={`${id}-title`}>
  <div class="inner">
    <div class="header">
      <div>
        <p class="label">{label}</p>
        <h2 class="title" id={`${id}-title`}>{title}</h2>
        {summary && <p class="summary">{summary}</p>}
      </div>
      <button type="button" class="close" aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <slot />
  </div>
</dialog>

<script>
  document.querySelectorAll<HTMLDialogElement>('dialog.modal').forEach(modal => {
    modal.querySelector('.close')?.addEventListener('click', () => modal.close());
  });
</script>

<style>
  :global(html:has(dialog.modal[open])) { overflow: hidden; }

  .modal {
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    overflow-y: auto;
    background: var(--bg);
    border: 0;
    color: var(--fg);
  }

  .modal[open] { animation: modal-in 0.2s ease-out; }

  @keyframes modal-in {
    from { opacity: 0; transform: translateY(8px) scale(0.98); }
  }

  .inner {
    max-width: 1200px;
    min-height: 100%;
    margin-inline: auto;
    padding: 3rem 2.5rem;
  }

  .header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .label {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  .title {
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }

  .summary { color: var(--muted); }

  .close {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    padding: 0;
    background: none;
    border: 1px solid var(--subtle);
    border-radius: 6px;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }

  .close:hover { color: var(--fg); border-color: #333333; }

  .close:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .modal[open] { animation: none; }
  }

  @media (max-width: 560px) {
    .inner { padding: 1.5rem; }
  }
</style>
