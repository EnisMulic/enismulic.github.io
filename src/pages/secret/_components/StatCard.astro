---
interface Props {
  label: string;
  value: string | number;
  caption?: string;
  tag?: string;
  // Footer text on the right, e.g. "View list"
  action?: string;
  // id of a <dialog> to open on click; makes the card a button
  opens?: string;
  // Dashed, muted, non-interactive card for sections that don't exist yet
  placeholder?: boolean;
  // Distance of the background art from the card's bottom edge
  artBottom?: string;
}

const { label, value, caption, tag, action, opens, placeholder = false, artBottom = '3.5rem' } = Astro.props;
const Tag = opens ? 'button' : 'div';
const hasArt = Astro.slots.has('art');
---

<Tag
  class:list={['card', { placeholder, interactive: Boolean(opens) }]}
  type={opens ? 'button' : undefined}
  data-opens={opens}
  aria-haspopup={opens ? 'dialog' : undefined}
>
  {hasArt && (
    <span class="art" aria-hidden="true" style={`bottom: ${artBottom}`}>
      <slot name="art" />
    </span>
  )}
  <span class="head">
    <span class="label">{label}</span>
    {Astro.slots.has('icon') && <span class="icon" aria-hidden="true"><slot name="icon" /></span>}
  </span>
  <span class="value" aria-hidden={placeholder ? 'true' : undefined}>{value}</span>
  {caption && <span class="caption">{caption}</span>}
  {(tag || action) && (
    <span class="footer">
      {tag && <span class="tag">{tag}</span>}
      {action && (
        <span class="action">
          {action}
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        </span>
      )}
    </span>
  )}
</Tag>

<script>
  document.querySelectorAll<HTMLButtonElement>('.card[data-opens]').forEach(card => {
    card.addEventListener('click', () => {
      const dialog = document.getElementById(card.dataset.opens ?? '');
      if (!(dialog instanceof HTMLDialogElement)) return;
      dialog.showModal();
      dialog.scrollTop = 0;
    });
  });
</script>

<style>
  .card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    background: #161616;
    border: 1px solid var(--subtle);
    border-radius: 8px;
    color: var(--fg);
    font: inherit;
    text-align: left;
    transition: border-color 0.15s, transform 0.2s;
  }

  .card > span:not(.art) { position: relative; }

  .interactive { cursor: pointer; }
  .interactive:hover { border-color: #333333; transform: translateY(-2px); }

  .interactive:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .placeholder {
    background: transparent;
    border-style: dashed;
    color: var(--muted);
  }

  .art {
    position: absolute;
    right: -1.5rem;
    width: 8rem;
    height: 8rem;
    color: var(--fg);
    opacity: 0.05;
    transition: opacity 0.2s;
  }

  .art :global(svg) { width: 100%; height: 100%; }
  .interactive:hover .art { opacity: 0.09; }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .label {
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.3;
  }

  .icon {
    display: flex;
    color: var(--muted);
  }

  .value {
    font-family: var(--font-serif);
    font-size: 3rem;
    line-height: 1;
  }

  .caption {
    margin-top: 0.35rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-top: 1.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--subtle);
  }

  .action {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--muted);
    white-space: nowrap;
    transition: color 0.15s;
  }

  .action svg { transition: transform 0.2s; }
  .interactive:hover .action { color: var(--accent); }
  .interactive:hover .action svg { transform: translateX(2px); }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .art { transition: none; }
    .interactive:hover { transform: none; }
  }
</style>
