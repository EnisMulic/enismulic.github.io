---
interface Props {
  // localStorage key that unlocks the content when set to '1'
  storageKey?: string;
  hint?: string;
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  storageKey = 'secret-unlocked',
  hint = 'This page has to be earned. Go solve the puzzle first.',
  ctaHref = '/projects',
  ctaLabel = 'Take me there',
} = Astro.props;
---

<div class="state" id="secret-locked">
  <div>
    <p class="label">Locked</p>
    <h1>Nice try</h1>
    <p class="hint">{hint}</p>
    <a href={ctaHref}>{ctaLabel}</a>
  </div>
</div>

<div id="secret-content" hidden>
  <slot />
</div>

<script is:inline define:vars={{ storageKey }}>
  (function () {
    var unlocked = false;
    try { unlocked = localStorage.getItem(storageKey) === '1'; } catch (e) {}
    if (!unlocked) return;
    document.getElementById('secret-locked')?.setAttribute('hidden', '');
    document.getElementById('secret-content')?.removeAttribute('hidden');
  })();
</script>

<style>
  .state {
    display: grid;
    place-items: center;
    min-height: 100vh;
    text-align: center;
  }

  .state[hidden] { display: none; }

  .label {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  h1 {
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }

  .hint {
    color: var(--muted);
    margin-bottom: 1.25rem;
  }

  a {
    font-size: 0.88rem;
    color: var(--accent);
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }
</style>
