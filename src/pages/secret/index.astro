---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
---

<Layout title="Secret — Enis Mulić">
  <Nav />
  <main>
    <div class="state" id="secret-locked">
      <div>
        <p class="label">Locked</p>
        <h1>Nice try</h1>
        <p class="hint">This page has to be earned. Go solve the puzzle first.</p>
        <a href="/projects">Take me there</a>
      </div>
    </div>

    <div class="state" id="secret-content" hidden>
      <div>
        <p class="label">Unlocked</p>
        <h1>You made it</h1>
        <p class="hint">I'm still working on this page. Check back soon.</p>
        <a href="/">Go home</a>
      </div>
    </div>
  </main>
</Layout>

<script is:inline>
  (function () {
    var unlocked = false;
    try { unlocked = localStorage.getItem('secret-unlocked') === '1'; } catch (e) {}
    if (!unlocked) return;
    document.getElementById('secret-locked')?.setAttribute('hidden', '');
    document.getElementById('secret-content')?.removeAttribute('hidden');
  })();
</script>

<style>
  .state {
    display: grid;
    place-items: center;
    min-height: 100vh;
    text-align: center;
  }

  .state[hidden] { display: none; }

  .label {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  h1 {
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }

  .hint {
    color: var(--muted);
    margin-bottom: 1.25rem;
  }

  .state a {
    font-size: 0.88rem;
    color: var(--accent);
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }
</style>
