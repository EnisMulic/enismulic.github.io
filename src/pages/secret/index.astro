---
import Layout from '../../modules/shared/Layout.astro';
import Nav from '../../modules/shared/Nav.astro';
import SecretGate from '../../modules/secret/components/SecretGate.astro';
import Widget from '../../modules/secret/components/Widget.astro';
import BooksWidget from '../../modules/secret/widgets/books/BooksWidget.astro';
import RecordsWidget from '../../modules/secret/widgets/records/RecordsWidget.astro';
import ConnectionsWidget from '../../modules/secret/widgets/connections/ConnectionsWidget.astro';
import LetterboxdWidget from '../../modules/secret/widgets/letterboxd/LetterboxdWidget.astro';
import PhotosWidget from '../../modules/secret/widgets/photos/PhotosWidget.astro';
---

<Layout title="Secret — Enis Mulić">
  <Nav />
  <main>
    <SecretGate>
      <div class="container unlocked">
        <div class="widgets">
          <BooksWidget />
          <RecordsWidget />
          <ConnectionsWidget />
          <LetterboxdWidget />
          <PhotosWidget />
          <Widget label="Coming soon" value="?" caption="Something new" tag="Work in progress" placeholder />
        </div>
      </div>
    </SecretGate>
  </main>
</Layout>

<style>
  .unlocked {
    width: min(1080px, 100% - 3rem);
    padding-top: calc(4rem + 72px);
    padding-bottom: 6rem;
  }

  .widgets {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 900px) {
    .widgets { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .widgets { grid-template-columns: 1fr; }
  }
</style>
