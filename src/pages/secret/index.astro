---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import SecretGate from './_components/SecretGate.astro';
import StatCard from './_components/StatCard.astro';
import CollectionModal from './_components/CollectionModal.astro';
import ConnectionsModal from './_components/ConnectionsModal.astro';
import { getEntry } from 'astro:content';
import { getBookItems, getVinylItems, type CollectionItem } from '../../data/collection';

const bookItems = await getBookItems();
const vinylItems = await getVinylItems();
const connections = (await getEntry('connections', 'stats'))?.data;
const lastPlayed = connections?.lastPlayed &&
  new Date(connections.lastPlayed).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });

const owned = (items: CollectionItem[]) => items.filter(i => !i.wishlist).length;
const wishlisted = (items: CollectionItem[]) => `${items.filter(i => i.wishlist).length} on the wishlist`;
---

<Layout title="Secret — Enis Mulić">
  <Nav />
  <main>
    <SecretGate>
      <div class="container unlocked">
        <div class="cards">
          <StatCard label="Books" value={owned(bookItems)} caption="owned" tag={wishlisted(bookItems)} action="View list" opens="books-modal">
            <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            <svg slot="art" viewBox="0 0 100 100" fill="currentColor"><rect x="8" y="22" width="14" height="70" rx="2"/><rect x="26" y="12" width="18" height="80" rx="2"/><rect x="48" y="28" width="12" height="64" rx="2"/><rect x="64" y="18" width="16" height="74" rx="2" transform="rotate(12 72 92)"/></svg>
          </StatCard>

          <!-- The record's circle reaches lower than the books, so its art sits higher to clear the footer line. -->
          <StatCard label="Records" value={owned(vinylItems)} caption="owned" tag={wishlisted(vinylItems)} action="View list" opens="records-modal" artBottom="4rem">
            <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/></svg>
            <svg slot="art" viewBox="0 0 100 100" fill="none" stroke="var(--bg)" stroke-width="0.8"><circle cx="50" cy="50" r="46" fill="currentColor" stroke="none"/><circle cx="50" cy="50" r="38"/><circle cx="50" cy="50" r="30"/><circle cx="50" cy="50" r="22"/><circle cx="50" cy="50" r="12" fill="var(--bg)" stroke="none"/><circle cx="62" cy="38" r="3" fill="var(--bg)" stroke="none"/></svg>
          </StatCard>

          <StatCard
            label="NYT Connections"
            value={connections?.currentStreak ?? '-'}
            caption="day streak"
            tag={lastPlayed && `Last played ${lastPlayed}`}
            action={connections && 'View stats'}
            opens={connections && 'connections-modal'}
            artBottom="4.25rem"
          >
            <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
            <svg slot="art" viewBox="0 0 100 100" fill="currentColor"><rect x="4" y="4" width="20" height="20" rx="3"/><rect x="28" y="4" width="20" height="20" rx="3"/><rect x="52" y="4" width="20" height="20" rx="3"/><rect x="76" y="4" width="20" height="20" rx="3"/><rect x="4" y="28" width="20" height="20" rx="3"/><rect x="28" y="28" width="20" height="20" rx="3"/><rect x="52" y="28" width="20" height="20" rx="3"/><rect x="76" y="28" width="20" height="20" rx="3"/><rect x="4" y="52" width="20" height="20" rx="3"/><rect x="28" y="52" width="20" height="20" rx="3"/><rect x="52" y="52" width="20" height="20" rx="3"/><rect x="76" y="52" width="20" height="20" rx="3"/><rect x="4" y="76" width="20" height="20" rx="3"/><rect x="28" y="76" width="20" height="20" rx="3"/><rect x="52" y="76" width="20" height="20" rx="3"/><rect x="76" y="76" width="20" height="20" rx="3"/></svg>
          </StatCard>

          {[1, 2, 3].map(() => (
            <StatCard label="Coming soon" value="?" caption="Something new" tag="Work in progress" placeholder />
          ))}
        </div>

        <CollectionModal id="books-modal" title="Books" items={bookItems} />
        <CollectionModal id="records-modal" title="Records" items={vinylItems} shape="square" />
        {connections && <ConnectionsModal id="connections-modal" stats={connections} />}
      </div>
    </SecretGate>
  </main>
</Layout>

<style>
  .unlocked {
    width: min(1080px, 100% - 3rem);
    padding-top: calc(4rem + 72px);
    padding-bottom: 6rem;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 900px) {
    .cards { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .cards { grid-template-columns: 1fr; }
  }
</style>
