---
import { items } from '../../data/items';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import ProjectCard from '../../components/ProjectCard.astro';
---

<Layout title="Projects — Enis Mulić" description="All projects — work at RUBICON and personal builds.">
  <Nav />
  <main>
    <div class="container">
      <div class="header-row">
        <a href="/" class="back">← Back</a>
        <div class="header-actions">
          <div class="filter-wrap">
            <button type="button" id="filter-toggle" class="icon-btn" aria-label="Filter projects" title="Filter projects" aria-expanded="false">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
            </button>
            <div class="filter-menu" id="filter-menu" hidden>
              <button type="button" class="filter-option active" data-filter="all">All</button>
              <button type="button" class="filter-option" data-filter="work">Work</button>
              <button type="button" class="filter-option" data-filter="project">Personal</button>
              <button type="button" class="filter-option" data-filter="school">School</button>
              <button type="button" class="filter-option" data-filter="random">???</button>
            </div>
          </div>
          <button type="button" id="flip-all" class="icon-btn" aria-label="Flip all cards" title="Flip all cards">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 2.1l4 4-4 4"/><path d="M3 12.9V11a4 4 0 0 1 4-4h14"/><path d="M7 21.9l-4-4 4-4"/><path d="M21 11.1V13a4 4 0 0 1-4 4H3"/></svg>
          </button>
        </div>
      </div>
      <p class="intro-note" id="intro-note">
        A list of all the projects I’ve worked on, in one way or another. 
        It includes a mix of paid work, side projects, school assignments, and a few things that never shipped.
      </p>
      <div class="grid">
        {items.map(item => <ProjectCard item={item} />)}
      </div>

      <div class="connections" id="connections-game" hidden>
        <p class="connections-status" id="connections-status">Pick 3 that share a category.</p>
        <div class="connections-grid" id="connections-grid"></div>
        <div class="connections-actions">
          <button type="button" id="connections-deselect" class="connections-btn" disabled>Deselect</button>
          <button type="button" id="connections-submit" class="connections-btn connections-btn-primary" disabled>Check</button>
        </div>
        <p class="connections-attempts">
          Attempts left:
          <span class="connections-lives" id="connections-lives" aria-label="Mistakes remaining">
            <span class="life-dot"></span>
            <span class="life-dot"></span>
            <span class="life-dot"></span>
            <span class="life-dot"></span>
          </span>
        </p>
      </div>

      <div class="win-modal" id="win-modal" hidden>
        <div class="win-modal-backdrop"></div>
        <div class="win-modal-panel" role="dialog" aria-modal="true" aria-labelledby="win-modal-title">
          <h2 id="win-modal-title">Solved it! 🎉</h2>
          <p>You found all three groups.</p>
          <div class="win-modal-actions">
            <button type="button" id="win-modal-close" class="connections-btn">Close</button>
            <button type="button" id="win-modal-continue" class="connections-btn connections-btn-primary">Continue</button>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  const flipAllBtn = document.getElementById('flip-all');
  const cards = document.querySelectorAll<HTMLElement>('.card');

  const filterToggle = document.getElementById('filter-toggle');
  const filterMenu = document.getElementById('filter-menu');
  const filterOptions = document.querySelectorAll<HTMLButtonElement>('.filter-option');

  filterToggle?.addEventListener('click', () => {
    const isOpen = !filterMenu?.hasAttribute('hidden');
    if (isOpen) {
      filterMenu?.setAttribute('hidden', '');
      filterToggle.setAttribute('aria-expanded', 'false');
    } else {
      filterMenu?.removeAttribute('hidden');
      filterToggle.setAttribute('aria-expanded', 'true');
    }
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    if (filterMenu && !filterMenu.hasAttribute('hidden') && !filterMenu.contains(target) && !filterToggle?.contains(target)) {
      filterMenu.setAttribute('hidden', '');
      filterToggle?.setAttribute('aria-expanded', 'false');
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && filterMenu && !filterMenu.hasAttribute('hidden')) {
      filterMenu.setAttribute('hidden', '');
      filterToggle?.setAttribute('aria-expanded', 'false');
      filterToggle?.focus();
    }
  });

  const grid = document.querySelector<HTMLElement>('.grid');
  const introNote = document.getElementById('intro-note');
  const connectionsGame = document.getElementById('connections-game');
  const connectionsGrid = document.getElementById('connections-grid');
  const connectionsStatus = document.getElementById('connections-status');
  const connectionsSubmit = document.getElementById('connections-submit') as HTMLButtonElement | null;
  const connectionsDeselect = document.getElementById('connections-deselect') as HTMLButtonElement | null;
  const lifeDots = document.querySelectorAll<HTMLElement>('#connections-lives .life-dot');

  const winModal = document.getElementById('win-modal');
  const winModalClose = document.getElementById('win-modal-close');
  const winModalContinue = document.getElementById('win-modal-continue');

  winModalClose?.addEventListener('click', () => {
    winModal?.setAttribute('hidden', '');
  });

  winModalContinue?.addEventListener('click', () => {
    window.location.href = '/secret';
  });

  const CATEGORY_LABEL: Record<string, string> = { work: 'Work', project: 'Personal', school: 'School' };
  const MAX_MISTAKES = 4;

  type Tile = { id: number; name: string; category: string; sourceCard: HTMLElement };

  let tiles: Tile[] = [];
  let selectedIds = new Set<number>();
  let groupedOrder: string[] = [];
  let revealedOnLoss = new Set<string>();
  let mistakes = 0;
  let gameOver = false;

  function buildPuzzle() {
    if (!connectionsGrid) return;

    const byCategory = new Map<string, HTMLElement[]>();
    cards.forEach(card => {
      const cat = card.dataset.category ?? '';
      if (!byCategory.has(cat)) byCategory.set(cat, []);
      byCategory.get(cat)?.push(card);
    });

    const picked: { name: string; category: string; sourceCard: HTMLElement }[] = [];
    byCategory.forEach((list, category) => {
      const shuffled = [...list].sort(() => Math.random() - 0.5);
      shuffled.slice(0, 3).forEach(sourceCard => {
        const name = sourceCard.querySelector('.card-front h3')?.textContent?.trim() ?? '';
        picked.push({ name, category, sourceCard });
      });
    });
    picked.sort(() => Math.random() - 0.5);

    tiles = picked.map((t, i) => ({ id: i, ...t }));
    selectedIds = new Set();
    groupedOrder = [];
    revealedOnLoss = new Set();
    mistakes = 0;
    gameOver = false;
    if (connectionsStatus) connectionsStatus.textContent = 'Pick 3 that share a category.';
    updateActionButtons();
    lifeDots.forEach(dot => dot.classList.remove('used'));

    render();
  }

  const scopeAttr = Array.from(connectionsGrid?.attributes ?? []).find(a => a.name.startsWith('data-astro-cid-'))?.name;

  function stamp<T extends HTMLElement>(el: T): T {
    if (scopeAttr) {
      el.setAttribute(scopeAttr, '');
      el.querySelectorAll('*').forEach(child => child.setAttribute(scopeAttr, ''));
    }
    return el;
  }

  function render() {
    if (!connectionsGrid) return;
    connectionsGrid.innerHTML = '';

    groupedOrder.forEach(category => {
      const row = stamp(document.createElement('div'));
      row.className = 'connections-row' + (revealedOnLoss.has(category) ? ' revealed' : '');
      row.dataset.category = category;

      const label = stamp(document.createElement('span'));
      label.className = 'connections-row-label';
      label.textContent = CATEGORY_LABEL[category] ?? category;
      row.appendChild(label);

      const itemsWrap = stamp(document.createElement('span'));
      itemsWrap.className = 'connections-row-items';
      itemsWrap.textContent = tiles.filter(t => t.category === category).map(t => t.name).join(', ');
      row.appendChild(itemsWrap);

      connectionsGrid.appendChild(row);
    });

    tiles.filter(t => !groupedOrder.includes(t.category)).forEach(tile => {
      const wrap = stamp(document.createElement('div'));
      wrap.className = 'connections-tile' + (selectedIds.has(tile.id) ? ' selected' : '');
      wrap.setAttribute('role', 'button');
      wrap.setAttribute('tabindex', '0');
      wrap.setAttribute('aria-label', `Select ${tile.name}`);
      if (gameOver) wrap.setAttribute('aria-disabled', 'true');

      const clone = tile.sourceCard.cloneNode(true) as HTMLElement;
      clone.classList.remove('flipped');
      clone.querySelectorAll('.info-icon, .desc, .links, .card-back').forEach(el => el.remove());
      wrap.appendChild(clone);

      if (!gameOver) {
        wrap.addEventListener('click', () => onTileClick(tile.id));
        wrap.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            onTileClick(tile.id);
          }
        });
      }

      connectionsGrid.appendChild(wrap);
    });
  }

  function onTileClick(id: number) {
    if (gameOver) return;

    if (selectedIds.has(id)) {
      selectedIds.delete(id);
    } else if (selectedIds.size < 3) {
      selectedIds.add(id);
    }

    updateActionButtons();
    render();
  }

  function updateActionButtons() {
    if (connectionsSubmit) connectionsSubmit.disabled = selectedIds.size !== 3;
    if (connectionsDeselect) connectionsDeselect.disabled = selectedIds.size === 0;
  }

  function updateLives() {
    lifeDots.forEach((dot, i) => dot.classList.toggle('used', i < mistakes));
  }

  connectionsDeselect?.addEventListener('click', () => {
    selectedIds = new Set();
    updateActionButtons();
    render();
  });

  connectionsSubmit?.addEventListener('click', () => {
    if (selectedIds.size !== 3) return;

    const selectedTiles = tiles.filter(t => selectedIds.has(t.id));
    const [first, ...rest] = selectedTiles;
    const isMatch = rest.every(t => t.category === first.category);

    if (isMatch) {
      groupedOrder.push(first.category);
      selectedIds = new Set();
      updateActionButtons();

      if (groupedOrder.length === byCategoryCount()) {
        gameOver = true;
        if (connectionsStatus) connectionsStatus.textContent = 'Solved.';
        try { localStorage.setItem('secret-unlocked', '1'); } catch {}
        winModal?.removeAttribute('hidden');
      }
      render();
    } else {
      mistakes += 1;
      updateLives();

      const shakeEls = Array.from(connectionsGrid?.querySelectorAll<HTMLButtonElement>('.connections-tile.selected') ?? []);
      shakeEls.forEach(t => t.classList.add('shake'));

      window.setTimeout(() => {
        selectedIds = new Set();
        updateActionButtons();

        if (mistakes >= MAX_MISTAKES) {
          gameOver = true;
          tiles.forEach(t => {
            if (!groupedOrder.includes(t.category)) revealedOnLoss.add(t.category);
          });
          groupedOrder = Array.from(new Set([...groupedOrder, ...tiles.map(t => t.category)]));
          if (connectionsStatus) connectionsStatus.textContent = 'Out of guesses.';
        }

        render();
      }, 400);
    }
  });

  function byCategoryCount() {
    return new Set(Array.from(cards).map(c => c.dataset.category)).size;
  }

  filterOptions.forEach(opt => {
    opt.addEventListener('click', () => {
      const filter = opt.dataset.filter ?? 'all';

      filterOptions.forEach(o => o.classList.toggle('active', o === opt));

      if (filter === 'random') {
        cards.forEach(card => { card.style.display = ''; });
        grid?.setAttribute('hidden', '');
        introNote?.setAttribute('hidden', '');
        connectionsGame?.removeAttribute('hidden');
        if (tiles.length === 0 || gameOver) buildPuzzle();
      } else {
        connectionsGame?.setAttribute('hidden', '');
        grid?.removeAttribute('hidden');
        introNote?.removeAttribute('hidden');
        cards.forEach(card => {
          const matches = filter === 'all' || card.dataset.category === filter;
          card.style.display = matches ? '' : 'none';
        });
      }

      filterToggle?.classList.toggle('active', filter !== 'all');
      filterMenu?.setAttribute('hidden', '');
      filterToggle?.setAttribute('aria-expanded', 'false');
    });
  });

  flipAllBtn?.addEventListener('click', () => {
    const anyUnflipped = Array.from(cards).some(card => !card.classList.contains('flipped'));
    cards.forEach(card => card.classList.toggle('flipped', anyUnflipped));
    const label = anyUnflipped ? 'Unflip all cards' : 'Flip all cards';
    flipAllBtn.setAttribute('aria-label', label);
    flipAllBtn.setAttribute('title', label);
    flipAllBtn.classList.toggle('active', anyUnflipped);
  });
</script>

<style>
  main {
    padding-top: calc(4rem + 72px);
    padding-bottom: 6rem;
  }

  .container { --max-w: 1100px; }

  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .intro-note {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--muted);
    max-width: 60ch;
    margin-bottom: 3rem;
  }

  .back {
    display: inline-block;
    font-size: 0.82rem;
    color: var(--muted);
    transition: color 0.15s;
  }

  .header-actions {
    display: flex;
    gap: 0.6rem;
  }

  .icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    color: var(--muted);
    background: none;
    border: 1px solid var(--subtle);
    border-radius: 6px;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }

  .icon-btn:hover {
    color: var(--fg);
    border-color: var(--muted);
  }

  .icon-btn.active {
    color: var(--accent);
    border-color: var(--accent);
  }

  .filter-wrap {
    position: relative;
  }

  .filter-menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: 10;
    display: flex;
    flex-direction: column;
    min-width: 8rem;
    padding: 0.35rem;
    background: #161616;
    border: 1px solid var(--subtle);
    border-radius: 8px;
  }

  .filter-menu[hidden] { display: none; }

  .filter-option {
    text-align: left;
    font-size: 0.82rem;
    color: var(--muted);
    background: none;
    border: none;
    border-radius: 5px;
    padding: 0.45rem 0.6rem;
    cursor: pointer;
    transition: color 0.15s, background 0.15s;
  }

  .filter-option:hover { color: var(--fg); }

  .filter-option.active {
    color: var(--accent);
    background: rgba(29, 78, 216, 0.1);
  }

  .back:hover { color: var(--fg); }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 900px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .grid { grid-template-columns: 1fr; }
  }

  .grid[hidden] { display: none; }

  .connections[hidden] { display: none; }

  .connections-status {
    font-size: 0.9rem;
    color: var(--muted);
    margin-bottom: 1.5rem;
  }

  .connections-attempts {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1rem;
    font-size: 0.82rem;
    color: var(--muted);
  }

  .connections-lives {
    display: flex;
    gap: 0.4rem;
  }

  .life-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--muted);
  }

  .life-dot.used {
    background: var(--subtle);
  }

  .connections-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }

  @media (max-width: 600px) {
    .connections-grid { gap: 0.4rem; }
  }

  .connections-tile {
    display: flex;
    flex-direction: column;
    min-height: 4.5rem;
    cursor: pointer;
    border-radius: 8px;
    box-shadow: 0 0 0 2px transparent;
    transition: box-shadow 0.15s, transform 0.15s;
  }

  @media (min-width: 601px) {
    .connections-tile { min-height: 7.5rem; }
  }

  .connections-tile > :global(.card) {
    flex: 1;
  }

  .connections-tile :global(.card-face) {
    padding: 0.6rem;
    gap: 0.25rem;
    align-items: center;
    justify-content: center;
  }

  .connections-tile :global(.card-face h3) {
    padding-right: 0;
    font-size: 0.75rem;
    line-height: 1.25;
    text-align: center;
  }

  @media (min-width: 601px) {
    .connections-tile :global(.card-face) { padding: 1.1rem; }
    .connections-tile :global(.card-face h3) { font-size: 1rem; font-weight: 600; }
  }

  .connections-tile[aria-disabled='true'] { cursor: default; }

  .connections-tile:hover:not([aria-disabled='true']) {
    box-shadow: 0 0 0 2px var(--muted);
  }

  .connections-tile.selected {
    box-shadow: 0 0 0 2px var(--accent);
  }

  .connections-row {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.35rem;
    padding: 1.5rem;
    border-radius: 8px;
    color: #161616;
    background: var(--subtle);
  }

  .connections-row[data-category='work'] { background: #a3e6a1; }
  .connections-row[data-category='project'] { background: #9ec5f5; }
  .connections-row[data-category='school'] { background: #f5d565; }

  .connections-row.revealed {
    opacity: 0.7;
    outline: 2px solid #161616;
    outline-offset: -2px;
  }

  .connections-row-label {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .connections-row-items {
    font-size: 0.9rem;
  }

  .connections-tile.shake {
    animation: connections-shake 0.4s ease;
  }

  @keyframes connections-shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-4px); }
    75% { transform: translateX(4px); }
  }

  .connections-actions {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .connections-btn {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--fg);
    background: rgba(255, 255, 255, 0.08);
    border: none;
    border-radius: 999px;
    padding: 0.6rem 1.4rem;
    cursor: pointer;
    transition: background 0.15s, opacity 0.15s;
  }

  .connections-btn:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.14);
  }

  .connections-btn:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .connections-btn-primary {
    background: rgba(255, 255, 255, 0.18);
  }

  .connections-btn-primary:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.24);
  }

  .win-modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .win-modal[hidden] { display: none; }

  .win-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
  }

  .win-modal-panel {
    position: relative;
    max-width: 26rem;
    width: calc(100% - 2.5rem);
    padding: 2rem;
    text-align: center;
    background: #161616;
    border: 1px solid var(--subtle);
    border-radius: 12px;
  }

  .win-modal-panel h2 {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    color: var(--fg);
    margin-bottom: 0.5rem;
  }

  .win-modal-panel p {
    font-size: 0.9rem;
    color: var(--muted);
    margin-bottom: 1.5rem;
  }

  .win-modal-actions {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
  }
</style>
