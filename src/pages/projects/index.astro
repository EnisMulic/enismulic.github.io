---
import { items } from '../../data/items';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
---

<Layout title="Projects — Enis Mulić" description="All projects — work at RUBICON and personal builds.">
  <Nav />
  <main>
    <div class="container">
      <div class="header-row">
        <a href="/" class="back">← Back</a>
        <div class="header-actions">
          <div class="filter-wrap">
            <button type="button" id="filter-toggle" class="icon-btn" aria-label="Filter projects" title="Filter projects" aria-expanded="false">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
            </button>
            <div class="filter-menu" id="filter-menu" hidden>
              <button type="button" class="filter-option active" data-filter="all">All</button>
              <button type="button" class="filter-option" data-filter="work">Work</button>
              <button type="button" class="filter-option" data-filter="project">Personal</button>
              <button type="button" class="filter-option" data-filter="school">School</button>
            </div>
          </div>
          <button type="button" id="flip-all" class="icon-btn" aria-label="Flip all cards" title="Flip all cards">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 2.1l4 4-4 4"/><path d="M3 12.9V11a4 4 0 0 1 4-4h14"/><path d="M7 21.9l-4-4 4-4"/><path d="M21 11.1V13a4 4 0 0 1-4 4H3"/></svg>
          </button>
        </div>
      </div>
      <p class="intro-note">
        A mix of paid work, side projects, school assignments, and a few things that never shipped.
        Am I proud of all of them? Not really. But they all took enough time or effort to be worth mentioning, at least for me.
      </p>
      <div class="grid">
        {items.map(item => (
          <article class="card" data-category={item.school ? 'school' : item.type}>
            <div class="card-inner">
              <div class="card-face card-front">
                <button type="button" class="info-icon" aria-label={`Show more about ${item.name}`}>
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                </button>
                <h3>{item.name}</h3>
                <p class="desc">{item.summary}</p>
                {(item.websiteUrl || item.caseStudyUrl || item.blogSlug || item.githubUrl || item.nugetUrl) && <div class="links">
                  {item.websiteUrl && (
                    <a href={item.websiteUrl} target="_blank" rel="noopener" class="link">
                      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                      Website
                    </a>
                  )}
                  {item.caseStudyUrl && (
                    <a href={item.caseStudyUrl} target="_blank" rel="noopener" class="link">
                      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                      Case Study
                    </a>
                  )}
                  {item.blogSlug && (
                    <a href={`/blog/${item.blogSlug}`} class="link">
                      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                      Case Study
                    </a>
                  )}
                  {item.githubUrl && (
                    <a href={item.githubUrl} target="_blank" rel="noopener" class="link">
                      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.755-1.335-1.755-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23a11.52 11.52 0 0 1 3-.405c1.02.005 2.045.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12z"/></svg>
                      GitHub
                    </a>
                  )}
                  {item.nugetUrl && (
                    <a href={item.nugetUrl} target="_blank" rel="noopener" class="link">
                      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                      NuGet
                    </a>
                  )}
                </div>}
              </div>
              <div class="card-face card-back">
                <button type="button" class="info-icon" aria-label={`Show less about ${item.name}`}>
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                </button>
                <h3>{item.name}</h3>
                {item.period && <p class="back-period">{item.period}</p>}
                <div class="tags">
                  {item.stack.map(s => <span class="tag">{s}</span>)}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>('.info-icon').forEach(btn => {
    btn.addEventListener('click', () => {
      btn.closest('.card')?.classList.toggle('flipped');
    });
  });

  const flipAllBtn = document.getElementById('flip-all');
  const cards = document.querySelectorAll<HTMLElement>('.card');

  const filterToggle = document.getElementById('filter-toggle');
  const filterMenu = document.getElementById('filter-menu');
  const filterOptions = document.querySelectorAll<HTMLButtonElement>('.filter-option');

  filterToggle?.addEventListener('click', () => {
    const isOpen = !filterMenu?.hasAttribute('hidden');
    if (isOpen) {
      filterMenu?.setAttribute('hidden', '');
      filterToggle.setAttribute('aria-expanded', 'false');
    } else {
      filterMenu?.removeAttribute('hidden');
      filterToggle.setAttribute('aria-expanded', 'true');
    }
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    if (filterMenu && !filterMenu.hasAttribute('hidden') && !filterMenu.contains(target) && !filterToggle?.contains(target)) {
      filterMenu.setAttribute('hidden', '');
      filterToggle?.setAttribute('aria-expanded', 'false');
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && filterMenu && !filterMenu.hasAttribute('hidden')) {
      filterMenu.setAttribute('hidden', '');
      filterToggle?.setAttribute('aria-expanded', 'false');
      filterToggle?.focus();
    }
  });

  filterOptions.forEach(opt => {
    opt.addEventListener('click', () => {
      const filter = opt.dataset.filter ?? 'all';

      filterOptions.forEach(o => o.classList.toggle('active', o === opt));

      cards.forEach(card => {
        const matches = filter === 'all' || card.dataset.category === filter;
        card.style.display = matches ? '' : 'none';
      });

      filterToggle?.classList.toggle('active', filter !== 'all');
      filterMenu?.setAttribute('hidden', '');
      filterToggle?.setAttribute('aria-expanded', 'false');
    });
  });

  flipAllBtn?.addEventListener('click', () => {
    const anyUnflipped = Array.from(cards).some(card => !card.classList.contains('flipped'));
    cards.forEach(card => card.classList.toggle('flipped', anyUnflipped));
    const label = anyUnflipped ? 'Unflip all cards' : 'Flip all cards';
    flipAllBtn.setAttribute('aria-label', label);
    flipAllBtn.setAttribute('title', label);
    flipAllBtn.classList.toggle('active', anyUnflipped);
  });
</script>

<style>
  main {
    padding-top: calc(4rem + 72px);
    padding-bottom: 6rem;
  }

  .container { --max-w: 1100px; }

  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .intro-note {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--muted);
    max-width: 60ch;
    margin-bottom: 3rem;
  }

  .back {
    display: inline-block;
    font-size: 0.82rem;
    color: var(--muted);
    transition: color 0.15s;
  }

  .header-actions {
    display: flex;
    gap: 0.6rem;
  }

  .icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    color: var(--muted);
    background: none;
    border: 1px solid var(--subtle);
    border-radius: 6px;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }

  .icon-btn:hover {
    color: var(--fg);
    border-color: var(--muted);
  }

  .icon-btn.active {
    color: var(--accent);
    border-color: var(--accent);
  }

  .filter-wrap {
    position: relative;
  }

  .filter-menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: 10;
    display: flex;
    flex-direction: column;
    min-width: 8rem;
    padding: 0.35rem;
    background: #161616;
    border: 1px solid var(--subtle);
    border-radius: 8px;
  }

  .filter-menu[hidden] { display: none; }

  .filter-option {
    text-align: left;
    font-size: 0.82rem;
    color: var(--muted);
    background: none;
    border: none;
    border-radius: 5px;
    padding: 0.45rem 0.6rem;
    cursor: pointer;
    transition: color 0.15s, background 0.15s;
  }

  .filter-option:hover { color: var(--fg); }

  .filter-option.active {
    color: var(--accent);
    background: rgba(29, 78, 216, 0.1);
  }

  .back:hover { color: var(--fg); }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 900px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .grid { grid-template-columns: 1fr; }
  }

  .card {
    display: flex;
    flex-direction: column;
    position: relative;
    perspective: 1500px;
  }

  .info-icon {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    z-index: 2;
    display: flex;
    background: none;
    border: none;
    padding: 0;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.15s;
  }

  .info-icon:hover { color: var(--accent); }

  .card-inner {
    position: relative;
    flex: 1;
    transform-style: preserve-3d;
    transition: transform 0.6s cubic-bezier(0.4, 0.2, 0.2, 1);
  }

  .card.flipped .card-inner { transform: rotateY(180deg); }

  .card-face {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem;
    background: #161616;
    border: 1px solid var(--subtle);
    border-radius: 8px;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .card-front { position: relative; height: 100%; }

  .card-back {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    transform: rotateY(180deg);
  }

  h3 {
    padding-right: 2rem;
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--fg);
    line-height: 1.3;
  }

  .desc {
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.65;
  }

  .back-period {
    font-size: 0.75rem;
    color: var(--muted);
    font-style: italic;
  }

  .tags { display: flex; flex-wrap: wrap; gap: 0.35rem; }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--subtle);
  }

  .link {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--muted);
    transition: color 0.15s;
    white-space: nowrap;
  }

  .link:hover { color: var(--accent); }
</style>
