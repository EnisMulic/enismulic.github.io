---
import Widget from '../../components/Widget.astro';
import type { Exercise } from './exercises';

interface Props {
  exercise: Exercise;
}

const { label, pr, goal, date } = Astro.props.exercise;

// 'm:ss' to seconds
const seconds = (time: string) => time.split(':').reduce((total, part) => total * 60 + Number(part), 0);

const timed = typeof pr === 'string';
const format = (value: number | string) => (timed ? String(value) : `${value} kg`);
// Share of the goal reached; for times the goal is the smaller number
const progress = timed
  ? seconds(String(goal)) / seconds(String(pr))
  : Number(pr) / Number(goal);
const done = progress >= 1;
const when = new Date(date);
const known = !isNaN(when.getTime());
const set = known
  ? when.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })
  : 'Unknown date';
---

<Widget label={label} value={format(pr)} caption={done ? `Goal ${format(goal)} hit` : `Goal: ${format(goal)}`} compact>
  {timed
    ? <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="14" r="8"/><polyline points="12 10 12 14 14 16"/><line x1="10" y1="2" x2="14" y2="2"/></svg>
    : <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="6" x2="6" y2="18"/><line x1="18" y1="6" x2="18" y2="18"/><line x1="3" y1="9" x2="3" y2="15"/><line x1="21" y1="9" x2="21" y2="15"/><line x1="6" y1="12" x2="18" y2="12"/></svg>}
  <span class:list={['progress', { done }]} role="img" aria-label={`${Math.round(Math.min(progress, 1) * 100)}% of goal`}>
    <span style={`width: ${Math.min(progress, 1) * 100}%`}></span>
  </span>
  <time class="date" datetime={known ? date : undefined}>{set}</time>
</Widget>

<style>
  .progress {
    display: block;
    height: 4px;
    margin-top: 1rem;
    border-radius: 2px;
    background: var(--subtle);
    overflow: hidden;
  }

  .progress span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--muted);
  }

  .done span { background: var(--accent); }

  .date {
    margin-top: 0.5rem;
    font-size: 0.75rem;
    color: var(--muted);
  }
</style>
