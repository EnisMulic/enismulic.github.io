---
import type { CollectionItem } from './shelf';
import CoverItem from './CoverItem.astro';
import Modal from '../../components/Modal.astro';

interface Props {
  // Used as the dialog's id; a Widget with the same `opens` value opens it
  id: string;
  title: string;
  items: CollectionItem[];
  shape?: 'portrait' | 'square';
}

const { id, title, items, shape } = Astro.props;
const wishlistCount = items.filter(i => i.wishlist).length;
const ownedCount = items.length - wishlistCount;
---

<Modal id={id} label="Collection" title={title} summary={`${ownedCount} owned, ${wishlistCount} on the wishlist`}>
  {items.length === 0 ? (
    <p class="empty">Nothing here yet.</p>
  ) : (
    <ul class="shelf">
      {items.map(item => <CoverItem item={item} shape={shape} />)}
    </ul>
  )}
</Modal>

<style>
  .shelf {
    margin-top: 3rem;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 2rem 1.25rem;
  }

  .empty {
    margin-top: 3rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  @media (max-width: 560px) {
    .shelf { grid-template-columns: repeat(2, 1fr); }
  }
</style>
