---
import type { CollectionEntry } from 'astro:content';
import Modal from '../../components/Modal.astro';

interface Props {
  // Used as the dialog's id; a Widget with the same `opens` value opens it
  id: string;
  photos: CollectionEntry<'photos'>['data'][];
}

const { id, photos } = Astro.props;

// "2024-10-06T15:27" as "6 Oct 2024, 15:27". The time is the camera's local time, so it's formatted as UTC to
// keep it unchanged.
const formatTaken = (taken: string) =>
  new Date(`${taken}Z`).toLocaleString('en-GB', {
    day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'UTC',
  });
// Date, time and place, for the lightbox and labels
const describe = (p: Props['photos'][number]) => [p.taken && formatTaken(p.taken), p.place].filter(Boolean).join(' · ');
---

<Modal id={id} label="Album" title="Photos" summary={`${photos.length} ${photos.length === 1 ? 'photo' : 'photos'}`}>
  {photos.length === 0 ? (
    <p class="empty">Nothing here yet.</p>
  ) : (
    <ul class="grid">
      {photos.map((p, i) => (
        <li>
          <button
            type="button"
            class="tile"
            data-index={i}
            data-url={p.url}
            data-description={describe(p)}
            aria-label={`Open photo ${i + 1}${describe(p) ? `: ${describe(p)}` : ''}`}
          >
            <img src={p.url} alt="" loading="lazy" decoding="async" />
          </button>
        </li>
      ))}
    </ul>
  )}
</Modal>

{photos.length > 0 && (
  <dialog class="lightbox" id={`${id}-lightbox`} aria-label="Photo">
    <img class="photo" alt="" />
    <p class="description"></p>
    <button type="button" class="nav prev" aria-label="Previous photo">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button type="button" class="nav next" aria-label="Next photo">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
    <button type="button" class="nav close" aria-label="Close photo">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </dialog>
)}

<script>
  document.querySelectorAll<HTMLDialogElement>('dialog.lightbox').forEach(lightbox => {
    const modal = document.getElementById(lightbox.id.replace(/-lightbox$/, ''));
    const tiles = [...(modal?.querySelectorAll<HTMLButtonElement>('.tile') ?? [])];
    const photo = lightbox.querySelector<HTMLImageElement>('.photo')!;
    const description = lightbox.querySelector<HTMLElement>('.description')!;
    let current = 0;

    const show = (index: number) => {
      current = (index + tiles.length) % tiles.length;
      const { url, description: text } = tiles[current].dataset;
      photo.src = url ?? '';
      photo.alt = text ?? '';
      description.textContent = text ?? '';
    };

    tiles.forEach((tile, i) => tile.addEventListener('click', () => {
      show(i);
      lightbox.showModal();
    }));
    lightbox.querySelector('.prev')?.addEventListener('click', () => show(current - 1));
    lightbox.querySelector('.next')?.addEventListener('click', () => show(current + 1));
    lightbox.querySelector('.close')?.addEventListener('click', () => lightbox.close());
    lightbox.addEventListener('keydown', e => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
    // Return focus to the photo that was open, so the album keeps its place
    lightbox.addEventListener('close', () => tiles[current].focus());
  });
</script>

<style>
  /* Rows fill left to right in date order; tiles share one portrait shape and the lightbox shows the whole photo */
  .grid {
    margin-top: 3rem;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
  }

  .tile {
    display: block;
    width: 100%;
    padding: 0;
    background: var(--subtle);
    border: 0;
    border-radius: 4px;
    overflow: hidden;
    cursor: zoom-in;
  }

  .tile img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    transition: transform 0.3s, opacity 0.15s;
  }

  .tile:hover img { transform: scale(1.02); opacity: 0.9; }

  .tile:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .empty {
    margin-top: 3rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .lightbox {
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    background: rgba(0, 0, 0, 0.94);
    border: 0;
    color: #ffffff;
  }

  .lightbox[open] {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .photo {
    max-width: calc(100% - 8rem);
    max-height: calc(100dvh - 7rem);
    object-fit: contain;
  }

  .description {
    min-height: 1.2em;
    margin-top: 1rem;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.7);
  }

  .nav {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    background: none;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }

  .nav:hover { color: #ffffff; border-color: rgba(255, 255, 255, 0.5); }

  .nav:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .prev { left: 1.25rem; top: 50%; transform: translateY(-50%); }
  .next { right: 1.25rem; top: 50%; transform: translateY(-50%); }
  .close { right: 1.25rem; top: 1.25rem; }

  @media (prefers-reduced-motion: reduce) {
    .tile img { transition: none; }
    .tile:hover img { transform: none; }
  }

  @media (max-width: 560px) {
    .grid { grid-template-columns: repeat(2, 1fr); gap: 0.75rem; }
    .photo { max-width: 100%; max-height: calc(100dvh - 9rem); }
    .description { margin-bottom: 4rem; }
    .prev, .next { top: auto; bottom: 1.25rem; transform: none; }
  }
</style>
