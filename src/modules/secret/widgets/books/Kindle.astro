---
// The Kindle the books are read on, drawn in the Books modal header
const model = 'Kindle (11th Generation)';
const firmware = '5.18.6';
---

<div class="kindle">
  <!-- Device colors are fixed: it's a black Kindle with an e-ink screen in every theme -->
  <svg class="device" viewBox="0 0 64 92" role="img" aria-label={model}>
    <rect x="1" y="1" width="62" height="90" rx="7" fill="#1b1b1b" stroke="#2e2e2e" stroke-width="1"/>
    <rect x="6" y="7" width="52" height="72" rx="1.5" fill="#e6e3da"/>
    <g fill="#9a978f">
      <rect x="11" y="13" width="26" height="2.5" rx="1"/>
      <rect x="11" y="21" width="42" height="1.6" rx="0.8"/>
      <rect x="11" y="25" width="40" height="1.6" rx="0.8"/>
      <rect x="11" y="29" width="42" height="1.6" rx="0.8"/>
      <rect x="11" y="33" width="36" height="1.6" rx="0.8"/>
      <rect x="11" y="39" width="42" height="1.6" rx="0.8"/>
      <rect x="11" y="43" width="41" height="1.6" rx="0.8"/>
      <rect x="11" y="47" width="42" height="1.6" rx="0.8"/>
      <rect x="11" y="51" width="39" height="1.6" rx="0.8"/>
      <rect x="11" y="55" width="42" height="1.6" rx="0.8"/>
      <rect x="11" y="59" width="28" height="1.6" rx="0.8"/>
      <rect x="28" y="72" width="8" height="1.4" rx="0.7"/>
    </g>
  </svg>
  <div class="specs">
    <p class="model">{model}</p>
    <p class="firmware">Firmware {firmware}</p>
  </div>
</div>

<style>
  .kindle {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .device {
    width: 96px;
    height: auto;
    flex-shrink: 0;
    filter: drop-shadow(0 4px 10px color-mix(in srgb, var(--bg) 60%, black));
  }

  .model {
    font-family: var(--font-serif);
    font-size: 1.25rem;
  }

  .firmware {
    margin-top: 0.3rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
</style>
