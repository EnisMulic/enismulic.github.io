---
import { getCollection, type CollectionEntry } from 'astro:content';
import Widget from '../../components/Widget.astro';
import CollectionModal from '../shelf/CollectionModal.astro';
import { byOrder, ownedCount, ownedFirst, wishlistTag } from '../shelf/shelf';

type Book = CollectionEntry<'books'>['data'];

const cover = (b: Book) =>
  b.coverUrl ?? (b.coverId ? `https://covers.openlibrary.org/b/id/${b.coverId}-L.jpg` : undefined);

const items = ownedFirst((await getCollection('books')).map(e => e.data).sort(byOrder).map(b => ({
  title: b.title,
  by: b.author,
  note: b.note,
  cover: cover(b),
  crop: b.coverCrop,
  wishlist: b.status === 'wishlist',
})));
---

<Widget label="Books" value={ownedCount(items)} caption="owned" tag={wishlistTag(items)} action="View list" opens="books-modal">
  <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
  <svg slot="art" viewBox="0 0 100 100" fill="currentColor"><rect x="8" y="22" width="14" height="70" rx="2"/><rect x="26" y="12" width="18" height="80" rx="2"/><rect x="48" y="28" width="12" height="64" rx="2"/><rect x="64" y="18" width="16" height="74" rx="2" transform="rotate(12 72 92)"/></svg>
</Widget>
<CollectionModal id="books-modal" title="Books" items={items} />
