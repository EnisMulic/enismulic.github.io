---
// Pulses the box around an image until it loads, then fades the image in. Put `data-loader` on the element that
// holds the image (it should have a background to pulse) and render this component once alongside it. Without
// JavaScript nothing changes: the image shows as it loads.
---

<script>
  document.querySelectorAll<HTMLImageElement>('[data-loader] img').forEach(img => {
    if (img.complete) return;
    const box = img.closest('[data-loader]')!;
    box.setAttribute('data-loading', '');
    // A broken image stops pulsing too
    const done = () => box.removeAttribute('data-loading');
    img.addEventListener('load', done, { once: true });
    img.addEventListener('error', done, { once: true });
  });
</script>

<style is:global>
  [data-loader] img { transition: opacity 0.3s; }
  [data-loading] img { opacity: 0; }
  [data-loading] { animation: image-loading 1.4s ease-in-out infinite; }

  @keyframes image-loading {
    50% { background-color: color-mix(in srgb, var(--subtle), var(--fg) 10%); }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-loading] { animation: none; }
  }
</style>
