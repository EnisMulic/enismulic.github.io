---
import type { CollectionEntry } from 'astro:content';
import Modal from './Modal.astro';

interface Props {
  id: string;
  stats: CollectionEntry<'connections'>['data'];
}

const { id, stats } = Astro.props;
const winPercent = stats.played ? Math.round((stats.won / stats.played) * 100) : 0;

const tiles = [
  { value: stats.played, label: 'Completed' },
  { value: winPercent, label: 'Win %' },
  { value: stats.currentStreak, label: 'Current streak' },
  { value: stats.maxStreak, label: 'Max streak' },
  { value: stats.mistakes[0], label: 'Perfect puzzles' },
  { value: stats.purpleFirst, label: 'Purple first' },
  { value: stats.reverseRainbow, label: 'Reverse rainbow' },
  { value: stats.mistakes[4], label: 'Lost' },
];

const lastPlayed = stats.lastPlayed &&
  new Date(stats.lastPlayed).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

const max = Math.max(...stats.mistakes, 1);
// Connections' group colors, easiest to hardest, for 0 to 3 mistakes; lost games (4) are gray.
// The mistake count beside each bar names it, so color isn't the only cue.
const colors = ['#f9df6d', '#a0c35a', '#b0c4ef', '#ba81c5', '#5a5a5a'];
const games = (n: number) => `${n} ${n === 1 ? 'game' : 'games'}`;
const mistakes = (i: number) => `${i} ${i === 1 ? 'mistake' : 'mistakes'}`;
---

<Modal id={id} label="NYT Games" title="Connections" summary={lastPlayed && `Last played ${lastPlayed}`}>
  <div class="content">
    <dl class="tiles">
      {tiles.map(t => (
        <div class="tile">
          <dt>{t.label}</dt>
          <dd>{t.value}</dd>
        </div>
      ))}
    </dl>

    <div class="distribution" role="group" aria-labelledby={`${id}-mistakes`}>
      <h3 id={`${id}-mistakes`}>Mistake distribution</h3>
      <ol class="rows">
        {stats.mistakes.map((count, i) => (
          <li class="row" title={`${games(count)} with ${mistakes(i)}${i === 4 ? ' (lost)' : ''}`}>
            <span class="key">{i}</span>
            <span class="track">
              <span class="bar" style={`--share: ${count / max}; background: ${colors[i]}`} />
              <span class="count">{count}</span>
            </span>
            <span class="sr-only">{mistakes(i)}{i === 4 ? ', lost' : ''}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</Modal>

<style>
  .content {
    max-width: 720px;
    margin-top: 3rem;
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--subtle);
    border: 1px solid var(--subtle);
    border-radius: 8px;
    overflow: hidden;
  }

  /* Value above label; values stay top-aligned when a label wraps */
  .tile {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.35rem;
    padding: 1.25rem;
    background: #161616;
  }

  dd {
    font-family: var(--font-serif);
    font-size: 2rem;
    line-height: 1;
  }

  dt {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .distribution { margin-top: 3rem; }

  h3 {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1.25rem;
  }

  .rows {
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }

  /* The whole row is the hover target, not just the bar */
  .row {
    display: grid;
    grid-template-columns: 1.25rem 1fr;
    align-items: center;
    cursor: default;
  }

  .key {
    font-size: 0.85rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .track {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  /* Scaled against the track minus room for the count, so lengths stay proportional */
  .bar {
    flex-shrink: 0;
    width: calc((100% - 3rem) * var(--share));
    height: 1.25rem;
    min-width: 2px;
    border-radius: 0 4px 4px 0;
    opacity: 0.85;
    transition: opacity 0.15s;
  }

  .row:hover .bar { opacity: 1; }

  .count {
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .tiles { grid-template-columns: repeat(2, 1fr); }
  }

  @media (prefers-reduced-motion: reduce) {
    .bar { transition: none; }
  }
</style>
